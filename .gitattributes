# Normalize to LF in the repository, check out as CRLF on disk. This project is
# developed on Windows with Visual Studio, so CRLF is the on-disk convention.
* text=auto

*.cs       text eol=crlf
*.csproj   text eol=crlf
*.slnx     text eol=crlf
*.resx     text eol=crlf
*.json     text eol=crlf
*.sql      text eol=crlf
*.md       text eol=crlf
.gitignore text eol=crlf
.gitattributes text eol=crlf

*.png      binary
*.ico      binary
*.cache    binary
